# Telegram API Credentials (Required - get from https://my.telegram.org/apps)
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=0123456789abcdef0123456789abcdef

# Session Management (Choose ONE)
# Option 1: File-based session (a .session file will be created)
TELEGRAM_SESSION_NAME=telegram_session
# Option 2: String-based session (if you generate one, e.g., using Telethon's string session generator)
TELEGRAM_SESSION_STRING=1231231232erfdfdffd

# OAuth Authentication (Required for SSE/remote deployment)
# Set these to secure your MCP server - use the same values in Claude's connector settings
OAUTH_CLIENT_ID=my-telegram-mcp
OAUTH_CLIENT_SECRET=generate-a-long-random-secret-here

# Chat Permissions (Optional - for controlling which chats are exposed to agents)
# Bot token for the permissions management bot (create via @BotFather)
PERMISSIONS_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ
# Telegram user ID of the person allowed to manage permissions
PERMISSIONS_BOT_OWNER_ID=123456789
# Path to permissions database (defaults to ./permissions.db)
# TELEGRAM_MCP_PERMISSIONS_DB=/path/to/permissions.db
